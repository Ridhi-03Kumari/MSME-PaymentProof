# PaymentProof Environment Variables
# Copy this to .env and fill in your values
# NEVER commit .env to version control

# AWS Configuration
AWS_REGION=ap-south-1
AWS_ACCOUNT_ID=your-account-id

# API Gateway
VITE_API_BASE_URL=https://your-api-id.execute-api.ap-south-1.amazonaws.com/dev

# Amazon Cognito
VITE_COGNITO_USER_POOL_ID=ap-south-1_XXXXXXXXX
VITE_COGNITO_CLIENT_ID=your-cognito-client-id
VITE_COGNITO_REGION=ap-south-1

# S3
VITE_DOCUMENTS_BUCKET=paymentproof-documents-dev-your-account-id

# DynamoDB
INVOICES_TABLE=PaymentProof-Invoices-dev

# CORS
CORS_ORIGIN=https://your-frontend-domain.amplifyapp.com

# Feature flags
VITE_DEMO_MODE=true  # Set to false when AWS is configured
